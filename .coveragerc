# Read by test-ratchet's run step in tests.yml, which keeps a repository's
# own coverage configuration. Its `source: .` measures the whole checkout,
# and run.py runs as a SUBPROCESS of the suite (the CLI cases start it with
# python3 -I), which the action's subprocess patch measures. `include`
# scopes the REPORT to the action's own modules -- run.py and
# scripts/ci/*.py, the subject the floor in .github/ci-thresholds.json
# gates; the suite's own helpers are measured too and simply do not appear
# in the report.

[report]
include =
    run.py
    scripts/ci/*.py
