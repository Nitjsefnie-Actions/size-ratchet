# The coverage configuration test-ratchet's run step keeps. run.py is a
# SUBPROCESS of the suite (the CLI cases run run.py with subprocess), and
# the step measures the Python processes the tests start, run.py included.
#
# `parallel` is what keeps the suite's several python3 processes from
# overwriting one another's data files. `include` scopes the REPORT to the
# action's own modules -- run.py and scripts/ci/*.py, the subject the floor
# in .github/ci-thresholds.json gates; the suite's own helpers are measured
# too and simply do not appear in the report.

[run]
parallel = True

[report]
include =
    run.py
    scripts/ci/*.py
